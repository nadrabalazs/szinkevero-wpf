<Window x:Class="szinkevero_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szinkevero_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Slider x:Name="sliRed" Minimum="0" Maximum="255"
            VerticalAlignment="Center" ValueChanged="sliRed_ValueChanged" />
        <Label Grid.Column="1" Content="0" VerticalAlignment="Center"
        HorizontalAlignment="Left" x:Name="redValue"></Label>
        <Label Grid.Column="2" Content="Red"
           VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Slider x:Name="sliGreen" Minimum="0" Maximum="255"
            Grid.Row="1"
            VerticalAlignment="Center" ValueChanged="sliGreen_ValueChanged" />
        <Label x:Name="greenValue" Grid.Column="1" Content="0" VerticalAlignment="Center"
            HorizontalAlignment="Left" Grid.Row="1"></Label>
        <Label Grid.Column="2" Grid.Row="1" Content="Green"
           VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Slider x:Name="sliBlue" Minimum="0" Maximum="255"
            Grid.Row="2"
            VerticalAlignment="Center" ValueChanged="sliBlue_ValueChanged" ></Slider>
        <Label Grid.Column="1" Grid.Row="2" Content="0" VerticalAlignment="Center"
            HorizontalAlignment="Left" x:Name="blueValue"></Label>
        <Label Grid.Column="2" Grid.Row="2" Content="Blue"
           VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Rectangle x:Name="rctTeglalap" Grid.Row="3" Grid.ColumnSpan="3" Fill="Black" Margin="10" />
    </Grid>
</Window>
